//]]></script><style>:root{--backgroundOpacityMurky: rgba(255, 255, 255, 0.75);--onBackgroundLight: #EAEAEA;--background: #FFF;--onBackground: #242424;--accent: #0070F6;--default-black: rgba(0, 0, 0, 0.00);--backgroundShadow: rgba(0, 0, 0, 0.14);--onAccent: #FFF;--onAccentDisabled: #B2D4FC;--onBackgroundDisabled: #919191;--onBackgroundSecondary: #5B5B5B;--onBackgroundExtraLight: #F4F4F4;--accentHighContrast: #0070F6;--backgroundButtonDisabled: rgba(68, 68, 68, 0.10);--onBackgroundExtraLight: #F4F4F4;--scrollTrack: #E8E8E8;--scrollThumb: #A1A1A1;--buttonHover: #E0E0E0;--img-logo: url(https://www.bing.com/assets/images/logo.06ee66dba3fb456590f1.svg);--img-completed: url(https://www.bing.com/assets/images/status_ok.d443655b70d223250fa8.svg);--img-alert: url(https://www.bing.com/assets/images/alert.474be14797d7e695bcaf.svg);--img-info: url(https://www.bing.com/assets/images/info.76492dcfe96104bd0b8d.svg);--img-cross: url(https://www.bing.com/assets/images/cross.1ac057fab21d8bdcc557.svg);--img-tooltip: url(https://www.bing.com/assets/images/tooltip.50ab4baeb9ac63633068.svg);--no-video-img: url(https://www.bing.com/assets/images/no-video-illustration.93cf90d69efb23abb01c.svg)}html[data-gen-theme=dark]{--backgroundOpacityMurky: rgba(0, 0, 0, 0.70);--onBackgroundLight: #414141;--background: #202020;--onBackground: #FFF;--accent: #0070F6;--default-black: rgba(0, 0, 0, 0.00);--backgroundShadow: rgba(0, 0, 0, 0.14);--onAccent: #FFF;--onAccentDisabled: #99C6FB;--onBackgroundDisabled: #8F8F8F;--onBackgroundSecondary: #C7C7C7;--onBackgroundExtraLight: #323232;--accentHighContrast: #59A4FF;--backgroundButtonDisabled: rgba(68, 68, 68, 0.10);--buttonHover: rgba(255, 255, 255, 0.1);--onBackgroundExtraLight: #323232;--scrollTrack: #323232;--scrollThumb: #505050;--img-info: url(https://www.bing.com/assets/images/info.b9fffb45ff14293838c6.svg);--img-cross: url(https://www.bing.com/assets/images/cross.7be73e495f991ab69f2f.svg);--img-tooltip: url(https://www.bing.com/assets/images/tooltip.e5ee59ba4cf836fe189b.svg);--no-video-img: url(https://www.bing.com/assets/images/no-video-illustration.22dbc541296956e1e782.svg)}@font-face{font-family:"Roboto Regular";src:url(https://www.bing.com/assets/fonts/Roboto-Regular.ttf) format("truetype");font-weight:400;font-style:normal;font-display:swap}@font-face{font-family:"Roboto Medium";src:url(https://www.bing.com/assets/fonts/Roboto-Medium.ttf) format("truetype");font-weight:500;font-style:normal;font-display:swap}@font-face{font-family:"Roboto Bold";src:url(https://www.bing.com/assets/fonts/Roboto-Bold.ttf) format("truetype");font-weight:700;font-style:normal;font-display:swap}@font-face{font-family:"Mier B03 Pan";src:url(https://www.bing.com/assets/fonts/MierB03-Regular.ttf) format("truetype");font-weight:400;font-style:normal;font-display:swap}.video-downloader-iframe-wrap{position:fixed;top:3px;right:3px;z-index:92147483645;width:530px;height:auto;background:var(--backgroundOpacityMurky, rgba(255, 255, 255, 0.75));transition:opacity .2s;border:none;margin-right:10px;overflow:hidden;border-radius:16px}.video-downloader-iframe-wrap.rtl{right:auto;left:3px;margin-right:0;margin-left:10px}.video-downloader-iframe{width:100%;height:auto;border:none;border-radius:16px;display:block;transition:opacity .2s;opacity:1;overflow-y:auto;overflow-x:hidden;box-shadow:none;backdrop-filter:none;background:rgba(0,0,0,0)}
/*# sourceMappingURL=data:application/json;base64, */</style><script src="./top chef_files/widget.js.téléchargement" id="rewards-widget" data-report-activity="false" data-dark-mode="false" data-settings="eyJ2ZXJ0aWNhbCI6ImltYWdlcyJ9" async=""></script><style data-rewards-widget-styles="true" data-style-id="medallion:medallion-main">div[data-rewards-widget].medallion .dailyCheckAnimationContainer {
  height: 32px;
  width: 32px;
  display: flex;
}

div[data-rewards-widget].medallion .dailyCheckAnimationContainer .meter {
  stroke: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion .dailyCheckAnimationContainer .dmeter {
  stroke: var(--rw-color, #c5c5c5);
}

div[data-rewards-widget].medallion .dailyCheckAnimationContainer .progress {
  stroke: var(--rw-color, #00b7ab);
}

div[data-rewards-widget].medallion .dailyCheckAnimationContainer .checkmark {
  stroke: var(--rw-color, #00b7ab);
}

div[data-rewards-widget].medallion .dailyCheckAnimationContainer .medal-circled {
  fill: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion .dailyCheckAnimationContainer .completedmeter {
  stroke: var(--rw-color, #00b7ab);
}

div[data-rewards-widget].medallion .dailyCheckAnimationContainer .overlapWithAbove {
  position: absolute;
  width: 32px;
  height: 32px;
}

div[data-rewards-widget].medallion .dailyCheckAnimationContainer .progressSvg {
  position: absolute;
  width: 32px;
  height: 32px;
}

div[data-rewards-widget].medallion .dailyCheckAnimationContainer .overlapWithAbove2 {
  position: absolute;
  top: 9px;
  left: 7px;
  width: 18px;
  height: 18px;
}

div[data-rewards-widget].medallion .parentContainer {
  position: relative;
  width: 32px;
  height: 32px;
}

div[data-rewards-widget].medallion .firework,
.firework::before,
.firework::after {
  position: absolute;
  top: 16px;
  left: 16px;
  transform: translate(-50%, -50%);
  width: 0vmin;
  aspect-ratio: 1;
  background: radial-gradient(circle, #7fdbff 0.4vmin, rgba(245, 245, 245, 0) 0 0) 50% 0%,
    radial-gradient(circle, #39cccc 0.4vmin, rgba(245, 245, 245, 0) 0 0) 0% 50%,
    radial-gradient(circle, #96e8de 0.5vmin, rgba(245, 245, 245, 0) 0 0) 50% 99%,
    radial-gradient(circle, #00b7ab 0.4vmin, rgba(245, 245, 245, 0) 0 0) 99% 50%,
    radial-gradient(circle, #39cccc 0.6vmin, rgba(245, 245, 245, 0) 0 0) 80% 90%,
    radial-gradient(circle, #96e8de 0.5vmin, rgba(245, 245, 245, 0) 0 0) 95% 90%,
    radial-gradient(circle, #39cccc 0.5vmin, rgba(245, 245, 245, 0) 0 0) 10% 60%,
    radial-gradient(circle, #39cccc 0.4vmin, rgba(245, 245, 245, 0) 0 0) 31% 80%,
    radial-gradient(circle, #00b7ab 0.3vmin, rgba(245, 245, 245, 0) 0 0) 80% 10%,
    radial-gradient(circle, #96e8de 0.6vmin, rgba(245, 245, 245, 0) 0 0) 90% 23%,
    radial-gradient(circle, #7fdbff 0.3vmin, rgba(245, 245, 245, 0) 0 0) 45% 20%,
    radial-gradient(circle, #39cccc 0.5vmin, rgba(245, 245, 245, 0) 0 0) 15% 60%,
    radial-gradient(circle, #39cccc 0.4vmin, rgba(245, 245, 245, 0) 0 0) 41% 80%,
    radial-gradient(circle, #00b7ab 0.3vmin, rgba(245, 245, 245, 0) 0 0) 85% 20%,
    radial-gradient(circle, #96e8de 0.6vmin, rgba(245, 245, 245, 0) 0 0) 95% 40%,
    radial-gradient(circle, #7fdbff 0.3vmin, rgba(245, 245, 245, 0) 0 0) 45% 10%,
    radial-gradient(circle, #00b7ab 0.3vmin, rgba(245, 245, 245, 0) 0 0) 84% 10%,
    radial-gradient(circle, #96e8de 0.5vmin, rgba(245, 245, 245, 0) 0 0) 95% 23%,
    radial-gradient(circle, #7fdbff 0.3vmin, rgba(245, 245, 245, 0) 0 0) 45% 23%,
    radial-gradient(circle, #39cccc 0.5vmin, rgba(245, 245, 245, 0) 0 0) 15% 62%,
    radial-gradient(circle, #39cccc 0.4vmin, rgba(245, 245, 245, 0) 0 0) 41% 55%,
    radial-gradient(circle, #00b7ab 0.3vmin, rgba(245, 245, 245, 0) 0 0) 85% 27%,
    radial-gradient(circle, #96e8de 0.6vmin, rgba(245, 245, 245, 0) 0 0) 95% 21%,
    radial-gradient(circle, #7fdbff 0.3vmin, rgba(245, 245, 245, 0) 0 0) 45% 20%,
    radial-gradient(circle, #7fdbff 0.5vmin, rgba(245, 245, 245, 0) 0 0) 13% 24%;
  background-size: 1.5vmin 1.5vmin;
  background-repeat: no-repeat;
  animation-delay: 1s;
  animation: firework 1s;
}

@keyframes firework {
  0% {
    width: 1.5vmin;
    opacity: 20;
  }

  100% {
    width: 12vmin;
    opacity: 0;
  }
}

/*# sourceMappingURL=data:application/json;charset=utf-8;base64, */:root {
  --rw-gp-balance-from: 0;
  --rw-gp-balance-to: 1000;
}

div[data-rewards-widget].medallion .gaining-points-animation {
  width: inherit;
  height: 32px;
}

/* Only apply balance-animation styles when PureCSS animation is enabled */
div[data-rewards-widget].medallion .points-container.balance-animation {
  animation: rw-purecss-counter var(--rw-purecss-animation-duration, 2s) cubic-bezier(0.075, 0.82, 0.165, 1);
  animation-fill-mode: forwards;
  counter-reset: num var(--rw-purecss-balance, var(--rw-purecss-balance-from));
}

div[data-rewards-widget].medallion .gaining-points-animation .circle-animation-container {
  position: relative;
}

div[data-rewards-widget].medallion .gaining-points-animation .outer-circle-animation {
  animation: rw-gp-expand-collapse 0.3s cubic-bezier(0.075, 0.82, 0.165, 1);
  animation-delay: 1s;
  height: 32px;
  width: 32px;
}

div[data-rewards-widget].medallion .gaining-points-animation svg.outer-circle-animation circle {
  stroke: var(--rw-color, var(--rw-medal-color));
  fill: none;
  stroke-width: 2;
}

div[data-rewards-widget].medallion .gaining-points-animation .medal-animation-container {
  position: absolute;
  top: 0px;
  height: 32px;
  width: 32px;
}

div[data-rewards-widget].medallion .gaining-points-animation .medal-svg-animation {
  position: relative;
  animation: rw-gp-expand-collapse 0.3s cubic-bezier(0.075, 0.82, 0.165, 1);
  animation-delay: 1s;
}

div[data-rewards-widget].medallion .gaining-points-animation .outer-circle-animation circle {
  fill: none;
  stroke: var(--rw-color, var(--rw-medal-color));
  stroke-width: 2;
  stroke-dasharray: 100.53, 100.53;
  stroke-dashoffset: 100.53;
  animation: rw-gp-animate-circle 1s linear forwards;
}

div[data-rewards-widget].medallion .gaining-points-animation .medal-svg-animation {
  position: relative;
  animation: rw-gp-expand-collapse 0.3s cubic-bezier(0.075, 0.82, 0.165, 1);
  animation-delay: 1s;
  fill: var(--rw-color, var(--rw-medal-color));
}

/* Only apply ::after content for balance-animation when PureCSS animation is enabled */
div[data-rewards-widget].medallion .points-container.balance-animation::after {
  content: counter(num, decimal);
  display: var(--rw-purecss-display, inline);
}

@property --rw-purecss-balance {
  syntax: '<integer>';
  initial-value: 0;
  inherits: false;
}

@keyframes rw-purecss-counter {
  from {
    --rw-purecss-balance: var(--rw-purecss-balance-from);
  }

  to {
    --rw-purecss-balance: var(--rw-purecss-balance-to);
  }
}

@keyframes rw-gp-animate-circle {
  to {
    stroke-dashoffset: 0;
  }
}

@keyframes rw-gp-expand-collapse {
  0% {
    transform: scale(1);
  }
  70% {
    transform: scale(1.2);
  }
  100% {
    transform: scale(1);
  }
}

/*# sourceMappingURL=data:application/json;charset=utf-8;base64, */div[data-rewards-widget].medallion .goal-tracking-container {
  width: 32px;
  height: 32px;
}

div[data-rewards-widget].medallion .medal-goal-track-meter {
  width: 32px;
  height: 32px;
  position: absolute;
  transform: rotate(-90deg);
}

div[data-rewards-widget].medallion .medal-goal-track-meter circle {
  stroke: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion .goal-track-medal-type {
  width: 32px;
  height: 32px;
  fill: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion .goal-track-outer-circle {
  width: 32px;
  height: 32px;
  position: absolute;
  stroke: var(--rw-color, var(--rw-medal-color));
  opacity: 0.4;
}

/*# sourceMappingURL=data:application/json;charset=utf-8;base64, */#rewid-af {
  position: absolute;
  z-index: 10;
  top: 50px;
  right: 0;
  font-size: 0;
  box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.1), 0 2px 4px 1px rgba(0, 0, 0, 0.18);
  border-radius: 5px;
}

#rewid-af:dir(rtl) {
  right: auto;
  left: 0;
}

#rewid-af iframe {
  border-radius: 5px;
}

/*# sourceMappingURL=data:application/json;charset=utf-8;base64, */#rewid-f {
  position: fixed;
  right: 0;
  top: 0;
  width: 376px;
  height: 100vh;
  z-index: 1100;
  box-shadow: 0 0 0 1px #0000000d, 0 0 0 2px #0000001a;
}

.b_pinhead #b_header #id_h #id_rh_w #rewid-f {
  visibility: visible;
}

#rewid-f.modern {
  position: absolute;
  z-index: 10;
  top: 50px;
  right: 0;
  font-size: 0;
  width: 0vh;
  height: 0vh;
  visibility: none;
}

#rewid-f.modern iframe {
  border-radius: 5px;
}

#rewid-f:dir(rtl) {
  right: auto;
  left: 0;
}

/*# sourceMappingURL=data:application/json;charset=utf-8;base64, */div[data-rewards-widget].medallion.rw-dark {
  --rw-medal-color: #a2b7f4;
  --rw-font-color: #edebe9;
  --rw-red-dot-color: #ff4c4c;
}

div[data-rewards-widget].medallion {
  --rw-medal-color: #174ae4;
  --rw-font-color: #333333;
  --rw-red-dot-color: #c80000;
  --rw-red-dot-diameter: 7px;
  display: inline-block;
  cursor: pointer;
  position: relative;
}

div[data-rewards-widget].medallion:not(.copilotSearch) > div {
  display: flex;
  align-items: center;
  text-decoration: none;
  height: 100%;
  padding: 0 4px;
}

div[data-rewards-widget].medallion:not(.copilotSearch) > div > * {
  padding: 0 4px;
  display: flex;
}

div[data-rewards-widget].medallion:not(.copilotSearch) .points-container {
  color: var(--rw-color, var(--rw-font-color));
  font-family: var(--rw-font-family);
  font-feature-settings: 'tnum';
  font-variant-numeric: tabular-nums;
  display: inline-block;
  text-align: right;
}

div[data-rewards-widget].medallion:not(.copilotSearch) div.medal {
  position: relative;
}

div[data-rewards-widget].medallion:not(.copilotSearch) svg.medal-circled {
  width: 32px;
  height: 32px;
  fill: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion svg.medal-new-level {
  width: 20px;
  height: 20px;
}

div[data-rewards-widget].medallion svg.medal-newlevel-circled {
  width: 32px;
  height: 32px;
}

div[data-rewards-widget].medallion svg.medal-circled circle {
  stroke: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion .light-ring svg.medal-circled circle {
  opacity: 0.3;
}

div[data-rewards-widget].medallion svg.medal-light {
  width: 32px;
  height: 32px;
  fill: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion .red-dot {
  width: var(--rw-red-dot-diameter);
  height: var(--rw-red-dot-diameter);
  border-radius: 50%;
  background-color: var(--rw-red-dot-color);
  top: -3px;
  right: 1px;
  position: absolute;
}

div[data-rewards-widget].medallion .red-dot.adjacent {
  right: 0;
  top: 0;
}

/* Sweepstakes specific styling */
div[data-rewards-widget].medallion.sweepstakes .points-container {
  font-weight: 500;
}

div[data-rewards-widget].medallion.sweepstakes {
  --rw-red-dot-color: #07641d;
}

div[data-rewards-widget].medallion.sweepstakes.rw-dark {
  --rw-red-dot-color: #8de971;
}
/* End Sweepstakes specific styling */

/* Frozen medallion specific styling */
div[data-rewards-widget].medallion.frozen {
  --rw-font-color: var(--rw-color, #000000);
}

div[data-rewards-widget].medallion.frozen.rw-dark {
  --rw-font-color: var(--rw-color, #ffffff);
}

div[data-rewards-widget].medallion.frozen .medal::before {
  content: '';
  display: inline-block;
  width: 32px;
  height: 32px;
}

div[data-rewards-widget].medallion.frozen .medal-frost {
  position: absolute;
  top: -3px;
}

div[data-rewards-widget].medallion.frozen .medal-frost #medalFrostIDTemplateFill {
  transform-origin: center;
  transform: translate(0px, 3px);
  fill: var(--rw-color, var(--rw-medal-color));
}

div[data-rewards-widget].medallion.frozen .medal-frost rect {
  stroke: var(--rw-color, var(--rw-medal-color));
}
/* End Frozen medallion specific styling */

/* Ocean Commotion specific styling */
div[data-rewards-widget].medallion.ocean-commotion .octopus-icon {
  transition: transform 0.1s cubic-bezier(0.25, 0.1, 0.25, 1);
  transform-origin: center;
  transform: scale(0.9);
}

div[data-rewards-widget].medallion.ocean-commotion .medal-circled circle {
  transition: opacity 0.2s cubic-bezier(0.25, 0.1, 0.25, 1);
}

div[data-rewards-widget].medallion.ocean-commotion .b_clickarea:hover .medal-circled .octopus-icon {
  transform: scale(1.3);
}

div[data-rewards-widget].medallion.ocean-commotion .b_clickarea:hover .medal-circled circle {
  opacity: 0.3;
}
/* End Ocean Commotion specific styling */

/* Copilot Search styles*/
div[data-rewards-widget].medallion.copilotSearch .points-container {
  color: var(--acf-color-fore-neutral-quaternary, rgba(0, 0, 0, 0.6));
  text-align: center;
  font-size: 13px;
  font-style: normal;
  font-weight: 400;
  line-height: 20px;
}

div[data-rewards-widget].medallion.copilotSearch .b_clickarea:hover .points-container {
  color: var(--acf-color-fore-neutral-secondary, rgba(0, 0, 0, 0.8));
}

div[data-rewards-widget].medallion.copilotSearch.rw-dark .points-container {
  color: var(--acf-color-fore-neutral-quaternary, rgba(255, 255, 255, 0.6));
}

div[data-rewards-widget].medallion.copilotSearch.rw-dark .b_clickarea:hover .points-container {
  color: var(--acf-color-fore-neutral-secondary, rgba(255, 255, 255, 0.8));
}

div[data-rewards-widget].medallion.copilotSearch div.medal {
  display: flex;
  align-items: center;
  justify-content: inherit;
}

div[data-rewards-widget].medallion.copilotSearch svg.medal-circled {
  fill: black;
  height: 17px;
  fill-opacity: 0.6;
}

div[data-rewards-widget].medallion.copilotSearch .b_clickarea:hover svg.medal-circled {
  fill: #202020;
  fill-opacity: unset;
}

div[data-rewards-widget].medallion.copilotSearch.rw-dark svg.medal-circled {
  fill: white;
}

div[data-rewards-widget].medallion.copilotSearch.rw-dark .b_clickarea:hover svg.medal-circled {
  fill: #cfdeff;
}

